<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RiskOfBonk</AssemblyName>
    <RootNamespace>RiskOfBonk</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- Default: reference assemblies from nuget (older game build). With -p:RoR2Managed=<game>/Risk of Rain 2_Data/Managed the
       installed game's own assemblies are used instead, so API changes in newer builds show up at compile time. -->
  <ItemGroup Condition="'$(RoR2Managed)' == ''">
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.3.1.275-r.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RoR2Managed)' != ''">
    <GameDll Include="$(RoR2Managed)/*.dll" Exclude="$(RoR2Managed)/System*.dll;$(RoR2Managed)/Mono.*.dll;$(RoR2Managed)/mscorlib.dll;$(RoR2Managed)/netstandard.dll;$(RoR2Managed)/Microsoft.*.dll;$(RoR2Managed)/Newtonsoft*.dll" />
    <Reference Include="@(GameDll)" Publicize="true"><Private>false</Private></Reference>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- BepInEx 5 is installed by Melty for Risk of Rain 2; referenced, not shipped. Path set by build.sh. -->
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AssetsTools.NET"><HintPath>../lib/AssetsTools.NET.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
